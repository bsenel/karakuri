# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env files — covers .env, .env.local, .env.production, .envrc, etc.
# .env.example stays tracked so contributors see the expected keys.
.env
.env.*
.envrc
!.env.example

# Karakuri runtime artifacts
bin/
karakuri.db
karakuri-obs/

# Frontend build output + deps. web/dist is embedded by web/embed.go at compile
# time (`make web-build` populates it; CI builds it before any Go job), so it is
# a build artifact rather than source.
web/dist/
web/node_modules/

# Editor/IDE
# .idea/
# .vscode/

# Playwright's own output. The report is a build artifact of a test run, not a
# thing to review in a diff.
web/playwright-report/
web/test-results/
